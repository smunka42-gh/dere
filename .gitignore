.env
*.log
__pycache__/
*.pyc
.DS_Store
venv/
# Scan output. The published scan IS committed — the deployed site
# reads it straight from the repo — so ignore the directory's other
# contents rather than the directory itself. Ignoring `output/`
# outright makes git refuse `git add output/latest_scan_sp500.json`,
# even though that file is tracked, because git never descends into an
# ignored directory to see the negation.
output/*
!output/latest_scan_sp500.json
!output/latest_scan_nifty50.json

# Private build log — session history, feedback quotes, decision provenance.
# Kept local for conversation-compaction continuity; never published.
BUILD_LOG.md

# Research/analysis code lives OUTSIDE this repo (see ../vantage-research).
# A module here that raised SystemExit at import time took the deployed
# site down: Streamlit inspects .py files across the repo at runtime.
research/
